# ─── DoomsDesk Environment Variables ─────────────────────────────────────────
# Copy this file to .env and fill in your values before running ./deploy.sh

# ── Required ──────────────────────────────────────────────────────────────────

# Secret used to sign JWT tokens — generate with: openssl rand -hex 32
JWT_SECRET=change-me-in-production

# Public URL of the web console (used for OAuth redirect URLs)
WEB_URL=https://your-domain.com

# Public URL of the backend API (used for OAuth redirect URIs)
OAUTH_REDIRECT_BASE=https://your-domain.com

# Public WebSocket URL of the signaling server (ws/wss)
NEXT_PUBLIC_WS_URL=wss://your-domain.com

# ── Optional: OAuth Social Login ──────────────────────────────────────────────

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── Optional: Stripe Billing ──────────────────────────────────────────────────

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Optional: CORS ────────────────────────────────────────────────────────────

# Restrict to your domain in production: https://your-domain.com
CORS_ORIGIN=*

# ── Optional: TURN Server ─────────────────────────────────────────────────────

# realm, user and password for the bundled coturn TURN server
TURN_REALM=doomsdesk.io
TURN_USER=doomsdesk
TURN_PASSWORD=turn123
